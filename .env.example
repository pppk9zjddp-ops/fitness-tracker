# Passwort fuer den Login. Leer lassen = kein Login (nur lokal sinnvoll).
APP_PASSWORD=

# Supabase. Leer lassen = lokaler Modus, Daten liegen in .data/local.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# KI-Schaetzung fuer Mahlzeiten (Text und Foto). Leer lassen = Funktion aus.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Token fuer den Apple-Health-Import per iOS-Kurzbefehl. Leer lassen = Import aus.
INGEST_TOKEN=
